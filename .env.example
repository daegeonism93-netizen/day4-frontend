# 로컬 실행용: 이 파일을 .env.local 로 복사하고 키를 넣으세요 (.env.local 은 git 에 올라가지 않습니다)
# Vercel 배포 시에는 Project Settings > Environment Variables 에 같은 이름으로 등록합니다.
GEMINI_API_KEY=
# 선택: 카카오 로컬 API (장소 검색 정확도 향상). 카카오 개발자 > 앱 > 'REST API 키' 를 넣으세요.
KAKAO_REST_API_KEY=
# 선택: 비우면 gemini-3.1-flash-lite → gemini-flash-latest → gemini-2.5-flash 순서로 시도
GEMINI_MODEL=
